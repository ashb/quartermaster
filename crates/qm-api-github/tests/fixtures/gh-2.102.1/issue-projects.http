POST /graphql HTTP/1.1
Host: api.github.com
User-Agent: GitHub CLI 2.102.1
Content-Length: 450
Accept: application/vnd.github.merge-info-preview+json, application/vnd.github.nebula-preview
Authorization: token quartermaster-p4-local-dummy
Content-Type: application/json
Graphql-Features: merge_queue
Time-Zone: Europe/London
X-Github-Api-Version: 2022-11-28
Accept-Encoding: gzip
Connection: close

{"query":"query IssueProjectItems($endCursor:String$name:String!$number:Int!$owner:String!){repository(owner: $owner, name: $name){issue(number: $number){projectItems(first: 100, after: $endCursor){totalCount,nodes{id,project{id,title},status:fieldValueByName(name: \"Status\"){... on ProjectV2ItemFieldSingleSelectValue{optionId,name}}},pageInfo{hasNextPage,endCursor}}}}}","variables":{"endCursor":null,"name":"demo","number":1,"owner":"fixture"}}
