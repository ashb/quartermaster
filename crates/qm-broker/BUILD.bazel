load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

objc_library(
    name = "context_protocol",
    srcs = ["native/protocol.m"],
    copts = ["-fblocks"],
    enable_modules = True,
    sdk_frameworks = [
        "Foundation",
        "LocalAuthentication",
        "AppKit",
    ],
    deps = ["//macos/Security/Sources/QuartermasterIPC:ipc_headers"],
)

rust_library(
    name = "qm_broker",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [
        "//crates/qm-providers:fixtures",
        "//macos/Security/Tests/QuartermasterSecurityTests:fixtures",
    ] + glob(["tests/fixtures/**"]),  # keep
    edition = "2024",
    link_deps = [":context_protocol"],
    proc_macro_deps = all_crate_deps(proc_macro = True),  # keep
    visibility = ["//visibility:public"],
    deps = [
        "//crates/qm-macos:qm_macos",
        "//crates/qm-providers:qm_providers",
        "//crates/qm-types:qm_types",
    ] + all_crate_deps(normal = True),  # keep
)

rust_test(
    name = "qm_broker_test",
    compile_data = ["Cargo.toml"],
    crate = ":qm_broker",
    edition = "2024",
    tags = ["local"],
    deps = all_crate_deps(normal_dev = True),  # keep
)

rust_test(
    name = "public_boundary",
    srcs = ["tests/public_boundary.rs"],
    compile_data = ["Cargo.toml"],
    edition = "2024",
    tags = ["local"],
    visibility = ["//visibility:public"],
    deps = [":qm_broker"] + all_crate_deps(normal_dev = True),  # keep
)

rust_doc_test(
    name = "qm_broker_doc_test",
    crate = ":qm_broker",
)
