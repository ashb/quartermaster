load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro", "rust_test")

exports_files(["Cargo.toml"])

rust_proc_macro(
    name = "qm_api_macros",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["Cargo.toml"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),  # keep
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),  # keep
)

rust_test(
    name = "qm_api_macros_test",
    compile_data = ["Cargo.toml"],
    crate = ":qm_api_macros",
    edition = "2024",
)
