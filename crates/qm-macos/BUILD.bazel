load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "qm_macos",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["Cargo.toml"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),  # keep
    visibility = ["//visibility:public"],
    deps = ["//crates/qm-types:qm_types"] + all_crate_deps(normal = True),  # keep
)

rust_test(
    name = "qm_macos_test",
    compile_data = ["Cargo.toml"],
    crate = ":qm_macos",
    edition = "2024",
    tags = ["local"],
    deps = all_crate_deps(normal_dev = True),  # keep
)

rust_doc_test(
    name = "qm_macos_doc_test",
    crate = ":qm_macos",
)
