load("@rules_swift//swift:swift_library.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "Luminare",
    srcs = glob(["Sources/Luminare/**/*.swift"]),
    copts = ["-swift-version", "6"],
    module_name = "Luminare",
    deps = [
        "@swiftui_introspect//:SwiftUIIntrospect",
        "@variadic_views//:VariadicViews",
    ],
)

genrule(
    name = "license",
    srcs = ["LICENSE.md"],
    outs = ["Luminare-LICENSE.txt"],
    cmd = "cp $(<) $(@)",
)
