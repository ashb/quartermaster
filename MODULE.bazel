module(name = "quartermaster")

bazel_dep(name = "apple_support", version = "2.10.1")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_apple", version = "5.3.1")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "gazelle", version = "0.51.3", dev_dependency = True)
bazel_dep(name = "gazelle_rust", version = "0.1.0", dev_dependency = True)
bazel_dep(name = "swift_gazelle_plugin", version = "0.2.2", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)
bazel_dep(name = "rules_go", version = "0.61.1", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.26.0")

single_version_override(
    module_name = "apple_support",
    patch_strip = 1,
    patches = ["//build:apple_support_clt.patch"],
    version = "2.10.1",
)

# Gazelle 0.1.0 needs the current extension path and a transitive crate lock.
# The patch lock was generated from its Cargo.lock with rules_rust 0.74.0.
single_version_override(
    module_name = "gazelle_rust",
    patch_strip = 1,
    patches = ["//build:gazelle_rust_extension.patch"],
    version = "0.1.0",
)

single_version_override(
    module_name = "swift_gazelle_plugin",
    patch_strip = 1,
    patches = ["//build:swift_gazelle_sdk_modules.patch"],
    version = "0.2.2",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.97.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive(
    name = "luminare",
    build_file = "//build:luminare.BUILD.bazel",
    sha256 = "da2d674c340b6e6cd4618e1bc03dc22d797b1da85a6ab9f3b8ddee3f2e38e80a",
    strip_prefix = "Luminare-7958d31278ad054abf0a7cf19e5ae700399a812f",
    type = "tar.gz",
    urls = ["https://codeload.github.com/MrKai77/Luminare/tar.gz/7958d31278ad054abf0a7cf19e5ae700399a812f"],
)

http_archive(
    name = "variadic_views",
    build_file = "//build:variadic_views.BUILD.bazel",
    sha256 = "abd44d931d70c1183055649bee64e81ec464ad11a2b11a415bb3447dfbd1e8f5",
    strip_prefix = "swiftui-variadic-views-af67d0e85bd2b499fbfb4cda834117e7c52b12b0",
    type = "tar.gz",
    urls = ["https://codeload.github.com/lorenzofiamingo/swiftui-variadic-views/tar.gz/af67d0e85bd2b499fbfb4cda834117e7c52b12b0"],
)

http_archive(
    name = "swiftui_introspect",
    build_file = "//build:swiftui_introspect.BUILD.bazel",
    sha256 = "ba527fe6e55f4242a37de5bb03f8f9cf342f4c52d14ab4e591451ab321d9f667",
    strip_prefix = "swiftui-introspect-807f73ce09a9b9723f12385e592b4e0aaebd3336",
    type = "tar.gz",
    urls = ["https://codeload.github.com/siteline/swiftui-introspect/tar.gz/807f73ce09a9b9723f12385e592b4e0aaebd3336"],
)

http_file(
    name = "github_rest_schema",
    dev_dependency = True,
    downloaded_file_path = "schema.json",
    sha256 = "b81f098026e98084a83f0a33db43502213919f68449b028543c373757766a758",
    urls = ["https://raw.githubusercontent.com/github/rest-api-description/c66e298030d4070b70a569dcd4268b3a041b5380/descriptions/api.github.com/api.github.com.json"],
)

http_file(
    name = "github_graphql_schema",
    dev_dependency = True,
    downloaded_file_path = "schema.graphql",
    sha256 = "0d71ca68a4e951599b2ea541a81cc259a843608fc22b8eb1713a1d03551b149e",
    urls = ["https://raw.githubusercontent.com/github/docs/6cbe6413ac7177bb692a78c171a74ae8be50d721/src/graphql/data/fpt/schema.docs.graphql"],
)

http_archive(
    name = "graphql_reference_node",
    build_file_content = 'exports_files(["bin/node"])',
    dev_dependency = True,
    sha256 = "037650d0839f457747396f052073fb48333d31bf5abd3c98b74da20d89ebb1ad",
    strip_prefix = "node-v22.23.4-darwin-arm64",
    urls = ["https://nodejs.org/download/release/v22.23.4/node-v22.23.4-darwin-arm64.tar.xz"],
)

http_archive(
    name = "graphql_reference",
    build_file_content = """
exports_files(["index.js"])
filegroup(
    name = "sources",
    srcs = glob(["**/*.js", "package.json"]),
    visibility = ["//visibility:public"],
)
""",
    dev_dependency = True,
    integrity = "sha512-mS1lbMsxgQj6hge1XZ6p7GPhbrtFwUFYi3wRzXAC/FmYnyXMTvvI3td3rjmQ2u8ewXueaSvRPWaEcgVVOT9Jnw==",
    strip_prefix = "package",
    urls = ["https://registry.npmjs.org/graphql/-/graphql-16.11.0.tgz"],
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    # GraphQL lookahead must ignore commas just like normal token consumption.
    crate = "apollo-parser",
    patch_args = ["-p1"],
    patches = ["//build:apollo_parser_ignored_commas.patch"],
    repositories = ["crates"],
    version = "0.8.7",
)
crate.annotation(
    # Apple's libtool adapter replaces archives instead of appending cc's batches.
    build_script_env = {"AR": "/usr/bin/ar"},
    crate = "ring",
    repositories = ["crates"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = ["aarch64-apple-darwin"],
)
use_repo(crate, "crates")
